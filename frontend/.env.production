# ═══════════════════════════════════════════════════════════
# ARIHANT WORLD — FRONTEND PRODUCTION ENV
# Copy to .env.local on AWS server for Next.js to pick up
# NEVER commit .env.local to git
# ═══════════════════════════════════════════════════════════

# Backend API — production subdomain (HTTPS)
NEXT_PUBLIC_API_URL=https://api.arihantworld.com/api

# Site meta
NEXT_PUBLIC_SITE_NAME=Arihant World
NEXT_PUBLIC_SITE_URL=https://arihantworld.com

# Razorpay LIVE key (public — safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxx

# Environment flag
NEXT_PUBLIC_ENV=production
