# ═══════════════════════════════════════════════════════════
# ARIHANT WORLD — FRONTEND PRODUCTION ENV
# Copy to .env.local on AWS server for Next.js to pick up
# NEVER commit .env.local to git
# ═══════════════════════════════════════════════════════════

# Backend API — production subdomain (HTTPS)
# NEXT_PUBLIC_API_URL=https://api.arihantdivinearts.in/api

# # Site meta
# NEXT_PUBLIC_SITE_NAME=Arihant World
# NEXT_PUBLIC_SITE_URL=https://arihantdivinearts.in

# # Razorpay LIVE key (public — safe to expose)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxx

# # Environment flag
# NEXT_PUBLIC_ENV=production



# ═══════════════════════════════════════════════════════════
# ARIHANT WORLD — FRONTEND DEVELOPMENT ENV
# ═══════════════════════════════════════════════════════════

# Backend API — local Node.js server
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Site meta
NEXT_PUBLIC_SITE_NAME=Arihant World
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay TEST key (public — safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx

# Environment flag
NEXT_PUBLIC_ENV=development
