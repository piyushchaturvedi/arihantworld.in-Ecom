# ARIHANT WORLD — BACKEND PRODUCTION ENV
# Copy this to .env on your AWS server and fill real values
# NEVER commit this file to git
# ═══════════════════════════════════════════════════════════

NODE_ENV=production
PORT=5000

# MongoDB Atlas — get from cloud.mongodb.com
MONGODB_URI=mongodb+srv://arihant_user:YOUR_STRONG_PASSWORD@cluster0.xxxxx.mongodb.net/arihant_world?retryWrites=true&w=majority

# JWT — generate: node -e "require('crypto').randomBytes(64).toString('hex').then?console.log:console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_FROM_CRYPTO_RANDOMBYTES
JWT_EXPIRE=30d

# Email — Gmail with App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=arihantdivinearts@gmail.com
EMAIL_PASS=nuyb bipo clzo cvrw
EMAIL_FROM=Arihant World <noreply@arihantworld.com>

# Razorpay LIVE keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_razorpay_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=646945479539836
CLOUDINARY_API_SECRET=82ogH2u5L5--kmShJ92zWRgxChY
